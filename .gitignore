# Default ignored files
/shelf/
/.idea/workspace.xml
# Editor-based HTTP Client requests
/httpRequests/
# Ignored default folder with query files
/queries/
# Datasource local storage ignored files
/dataSources/
/dataSources.local.xml
/.idea/
/target/

# Custom campaigns (local data)
/data/custom-campaigns/
# Bundled campaign resources are tracked for now so the campaign is backed up
# and shared. Re-enable this ignore to ship a generic build without campaign data.
#/src/main/resources/data/custom-campaigns/

# User accounts + SMTP credentials (local, never committed)
/data/auth/

# A player's cache of a session their DM is hosting; rebuilt on every join.
/data/joined-sessions/
# A player's own portraits, names and descriptions for their characters.
/data/player-profiles/


# Machine-translation cache and UI settings (per user)
/data/translations/
/data/settings.json

# Linked GitHub account for campaign sync (per OS user, token encrypted on Windows; never committed)
/data/github/

# Build-time translator environment (tools/i18n/translate.py)
/tools/i18n/.venv/
__pycache__/
